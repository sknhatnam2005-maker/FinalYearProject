# Đổi tên file này thành ".env" và điền giá trị thật

# MongoDB local (nếu dùng MongoDB Compass/local):
MONGODB_URI=mongodb://127.0.0.1:27017/gochoc

# Hoặc MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gochoc?retryWrites=true&w=majority

JWT_SECRET=thay_doi_chuoi_nay_thanh_bi_mat_cua_ban
PORT=5000

# Đăng nhập bằng Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized JavaScript origins: http://localhost:5173 và http://localhost
GOOGLE_CLIENT_ID=

# Tìm GIF trong bình luận / tin nhắn: developers.giphy.com → Create an App → API → copy API Key
GIPHY_API_KEY=
